# LAFhvst 릴레이 — TLS 종단 + WebSocket 업그레이드 + 8788 루프백 프록시.
#
#   DNS:   relay.<도메인>  A/AAAA  ->  이 서버 공인 IP
#   Caddy: 이 파일을 /etc/caddy/Caddyfile 로 두고 `systemctl reload caddy`
#
# Let's Encrypt 인증서는 Caddy 가 자동 발급/갱신한다(80/443 만 공개하면 된다).
# relayd 는 127.0.0.1:8788 에만 바인딩하므로 8788 은 방화벽에서 열지 않는다.

relay.example.com {
	# 요청 본문은 릴레이가 8 MiB 에서 끊으므로 Caddy 는 넉넉히만 막는다.
	request_body {
		max_size 64MB
	}

	reverse_proxy 127.0.0.1:8788 {
		# WebSocket 업그레이드(/agent)는 reverse_proxy 가 자동 처리한다.
		# 응답 스트리밍을 버퍼링하지 않도록 즉시 flush.
		flush_interval -1

		# relayd 는 uvicorn 의 `--proxy-headers --forwarded-allow-ips 127.0.0.1`
		# 로 실행되며, 여기서 넣은 X-Forwarded-For 를 신뢰해 실제 클라이언트 IP 를
		# `X-LAF-Client-IP` 로 주입한다.
		header_up X-Forwarded-For {http.request.remote.host}
		header_up X-Forwarded-Proto {scheme}

		# 릴레이 타임아웃(30/60초)보다 넉넉하게 잡아 릴레이가 먼저 응답하도록 한다.
		transport http {
			read_timeout 300s
			write_timeout 300s
			dial_timeout 5s
		}
	}

	log {
		output file /var/log/caddy/relay-access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}
